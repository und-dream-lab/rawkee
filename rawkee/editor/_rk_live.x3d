<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.1//EN" "https://www.web3d.org/specifications/x3d-4.1.dtd">
<X3D profile='Core' version='4.1' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.1.xsd'>
	<head>
		<component name='Scripting' level='1'/>
		<component name='Grouping' level='1'/>
	</head>
	<Scene>
		<Script DEF='Script1' containerField='children'>
			<field name='scriptTransforms' type='MFNode' accessType='inputOutput'>
				<Transform DEF='Transform1'/>
				<Transform DEF='Transform2'/>
			</field>
			<field name='toggle' type='SFBool' accessType='inputOutput' value='True'/>
			<![CDATA[
			ecmascript:
			
			// Optional: Called once when the X3D scene finishes loading
			function initialize() {
			   Browser.println("Hi there!");
			}
			]]>
		</Script>
	</Scene>
</X3D>
